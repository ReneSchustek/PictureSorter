<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Data ist plattformneutral; die Tests laufen gegen eine echte SQLite-Datei. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xunit.v3 baut jedes Testprojekt als eigenständiges Programm. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PictureSorter.Core\PictureSorter.Core.csproj" />
    <ProjectReference Include="..\..\src\PictureSorter.Data\PictureSorter.Data.csproj" />
  </ItemGroup>

</Project>
