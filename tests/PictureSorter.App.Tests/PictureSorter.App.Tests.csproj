<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Muss dem Windows-SDK-Ziel von PictureSorter.App entsprechen. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xunit.v3 baut jedes Testprojekt als eigenständiges Programm. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Kein XAML-Host: die ViewModels sind UI-frei und laufen ohne WinUI-Laufzeit. -->
    <UseWinUI>false</UseWinUI>
    <!-- PictureSorter.App wird als x64 gebaut; das Testprojekt muss dieselbe
         Architektur nutzen. Die App ist self-contained, daher muss auch dieses
         Projekt self-contained sein (sonst greift der NETSDK1151-Check).
         'Platforms' muss x64 enthalten, sonst zeigt die .slnx auf eine Plattform,
         die das Projekt nicht kennt (Visual Studio meldet dann eine unbekannte
         Projektkonfigurationszuordnung). -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WindowsAppSDKSelfContained wird hier bewusst NICHT gesetzt: Die Eigenschaft
         lässt das SDK seinen Auto-Initialisierer in die Kompilierung einschleusen. In
         PictureSorter.App gehört er hin, hier würde er dieselben Typen ein zweites Mal
         definieren (CS0436). Die Laufzeit-DLLs kommen ohnehin aus der App-Ausgabe. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PictureSorter.App\PictureSorter.App.csproj" />
    <ProjectReference Include="..\..\src\PictureSorter.Application\PictureSorter.Application.csproj" />
    <ProjectReference Include="..\..\src\PictureSorter.Core\PictureSorter.Core.csproj" />
  </ItemGroup>

</Project>
