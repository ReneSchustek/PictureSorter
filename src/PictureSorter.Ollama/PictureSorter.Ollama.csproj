<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Reine HTTP-Anbindung an Ollama (kein WinRT) – daher plattformneutrales net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PictureSorter.Core\PictureSorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- IHttpClientFactory + getypter Client für die Ollama-Anbindung. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Options-Pattern inkl. Bindung aus appsettings.json und DataAnnotations-Validierung. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSorter.Ollama.Tests" />
  </ItemGroup>

</Project>
