<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PictureSorter.App</RootNamespace>
    <AssemblyName>PictureSorter</AssemblyName>
    <!-- Die Version kommt zentral aus Directory.Build.props (siehe VERSION). -->

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Standardsprache der Ressourcen (Fallback, wenn die Systemsprache fehlt). -->
    <DefaultLanguage>de-DE</DefaultLanguage>
    <!-- Bettet das Icon in die EXE ein (Explorer, Taskleiste, gepinnte
         Verknüpfung). Das Laufzeit-Fenstericon wird zusätzlich über
         AppWindow.SetIcon gesetzt. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- Ohne aktive Plattform kann WindowsAppSDKSelfContained keine Architektur
         auflösen und der Build bricht ab ("requires a supported Windows
         architecture"). Beim Bauen der Solution pinnt die .slnx x64; wird dagegen
         nur dieses Projekt gebaut (etwa per 'dotnet run'), ist Platform leer bzw.
         AnyCPU. Dann fällt die Wahl hier auf x64, damit der in der README
         dokumentierte Startbefehl ohne zusätzliche Parameter funktioniert. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <!-- Nötig für [LibraryImport]: Der Quellgenerator erzeugt den Marshalling-Code
         für die Windows-Signaturprüfung (WinVerifyTrust) mit unsicheren Zeigern.
         Eigener unsicherer Code wird nicht geschrieben. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Standardmäßig unpackaged: F5/Run und die portable Variante laufen ohne
         Deploy. Für ein MSIX-Paket explizit mit -p:WindowsPackageType=MSIX bauen. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <!-- Die App bringt die Windows App Runtime selbst mit, statt eine installierte zu
         suchen. Ohne das kompiliert das SDK einen Auto-Initialisierer in die Assembly,
         der beim Laden nach einer installierten Runtime sucht und, wenn er keine
         findet, einen MODALEN Dialog zeigt. Auf einem Rechner ohne Runtime (CI-Runner,
         frisch aufgesetztes Windows) blockiert der für immer: die portable App startet
         nie, und der Testhost hängt, sobald er eine Klasse aus diesem Projekt lädt. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling Condition="'$(WindowsPackageType)' != 'None'">true</EnableMsixTooling>
  </PropertyGroup>

  <!-- MSIX-Signierung: nur für paketierte Builds. Das selbstsignierte
       Testzertifikat (Subjekt CN=AppPublisher, passend zum Publisher im
       Package.appxmanifest) erlaubt das lokale Erstellen und Sideloaden des
       Pakets. NICHT für die Verteilung gedacht – für ein Release ein echtes
       Code-Signing-Zertifikat verwenden. -->
  <PropertyGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>PictureSorter.App_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PictureSorter.App_TemporaryKey.pfx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />

    <!-- Eigenes Bild für die Titelleiste, in genau der Größe, in der es dort erscheint
         (32 Punkte, und 64 für 200-%-Bildschirme). Aus der Symboldatei heraus musste
         WinUI die Anzeigegröße erst errechnen und traf sie um wenige Punkte nicht — das
         Symbol wurde dadurch sichtbar unscharf. -->
    <Content Include="Assets\AppIconTitleBar.scale-100.png" />
    <Content Include="Assets\AppIconTitleBar.scale-200.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- SplashScreen-Logo wird ins Assembly eingebettet (nie zur Laufzeit aus einer
       Datei geladen). Der Build bricht ab, wenn das Logo fehlt. -->
  <ItemGroup>
    <None Remove="Assets\SplashLogo.png" />
    <EmbeddedResource Include="Assets\SplashLogo.png" LogicalName="PictureSorter.App.Assets.SplashLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Einrichtungsskript für Ollama wird ins Ausgabeverzeichnis kopiert und vom
       OllamaSetupService gestartet. -->
  <ItemGroup>
    <None Update="Tools\install-ollama.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <!-- Feste Versionen: Mit "*" hing die ausgelieferte Fassung davon ab, wann
         zuletzt wiederhergestellt wurde. Das widerspricht dem reproduzierbaren
         Build und entwertet die Schwachstellenprüfung, die ja eine bestimmte
         Version bewertet. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <!-- Die ViewModels sind intern (CA1515); das Testprojekt braucht Zugriff. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PictureSorter.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PictureSorter.Application\PictureSorter.Application.csproj" />
    <ProjectReference Include="..\PictureSorter.Core\PictureSorter.Core.csproj" />
    <ProjectReference Include="..\PictureSorter.Data\PictureSorter.Data.csproj" />
    <ProjectReference Include="..\PictureSorter.Imaging\PictureSorter.Imaging.csproj" />
    <ProjectReference Include="..\PictureSorter.Infrastructure\PictureSorter.Infrastructure.csproj" />
    <ProjectReference Include="..\PictureSorter.Ollama\PictureSorter.Ollama.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Trimming und ReadyToRun sind mit WinUI 3 + .NET 10 noch nicht kompatibel. -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Verteidigung in der Tiefe: Build schlaegt fehl, wenn das eingebettete
       Splash-Logo fehlt (splashscreen.md). -->
  <Target Name="ValidateSplashLogoEmbeddedResource" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)\Assets\SplashLogo.png')"
      Text="SplashScreen-Logo fehlt: Assets\SplashLogo.png muss vorhanden und als EmbeddedResource eingebettet sein." />
  </Target>

  <!-- Die eigene Ressourcendatei (PictureSorter.pri) entsteht beim Build, wird von
       `dotnet publish` bei einer unpaketierten WinUI-App aber NICHT mit ausgegeben.
       Ohne sie findet WinUI kein einziges XAML: Die Anwendung bricht schon beim ersten
       Fenster mit einer XamlParseException ab. Der Build bleibt dabei grün und die
       Tests auch, weil beide die Datei aus dem bin-Ordner sehen; auffallen kann es
       einzig beim Start der ausgelieferten Fassung. -->
  <Target Name="ProjektPriMitVeroeffentlichen" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Include="$(ProjectPriFullPath)"
        Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')">
        <RelativePath>$([System.IO.Path]::GetFileName('$(ProjectPriFullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Verteidigung in der Tiefe, wie beim Splash-Logo: Fehlt die Ressourcendatei in der
       Ausgabe, soll die Veröffentlichung abbrechen statt ein Paket zu erzeugen, das
       sich nicht starten lässt. Genau das ist bis 1.4.0 unbemerkt ausgeliefert worden. -->
  <Target Name="ValidateProjektPriImPublish" AfterTargets="Publish">
    <Error
      Condition="!Exists('$(PublishDir)$(AssemblyName).pri')"
      Text="Ressourcendatei $(AssemblyName).pri fehlt in der Veröffentlichung. Ohne sie startet die Anwendung nicht (XamlParseException im ersten Fenster)." />
  </Target>

  <!-- Dieselbe Falle in klein: Das Einrichtungsskript lag lange nur auf dem
       Entwicklungsrechner, weil die .gitignore alle .ps1-Dateien ausschloss. Der Build
       blieb grün, das <None Update="..."> lief ins Leere, und jede ausgelieferte
       Fassung meldete beim Knopf "Jetzt einrichten" nur, sie könne nicht starten.
       Ein fehlendes Skript soll deshalb den Build anhalten, nicht den Nutzer. -->
  <Target Name="ValidateOllamaSetupSkript" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)\Tools\install-ollama.ps1')"
      Text="Einrichtungsskript fehlt: Tools\install-ollama.ps1 wird mit ausgeliefert und vom OllamaSetupService gestartet." />
  </Target>

  <Target Name="ValidateOllamaSetupSkriptImPublish" AfterTargets="Publish">
    <Error
      Condition="!Exists('$(PublishDir)Tools\install-ollama.ps1')"
      Text="Einrichtungsskript fehlt in der Veröffentlichung: Tools\install-ollama.ps1. Ohne es scheitert die geführte Einrichtung der lokalen KI." />
  </Target>
</Project>
