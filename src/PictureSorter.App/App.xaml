<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PictureSorter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PictureSorter.App.Converters"
    xmlns:local="using:PictureSorter.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/AppColors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:PathToThumbnailConverter x:Key="ThumbnailConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StatusSeverityToInfoBarSeverityConverter x:Key="StatusSeverityConverter" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
            <converters:StepReachedConverter x:Key="StepReachedConverter" />

            <!-- Karten-Optik: weiße (bzw. dunkle) abgerundete Fläche mit Rahmen,
                 abgesetzt von der Arbeitsfläche. Wird auf der Einstellungsseite und
                 im Sortier-Assistenten verwendet. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
