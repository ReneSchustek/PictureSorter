<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PictureSorter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PictureSorter.App.Converters"
    xmlns:local="using:PictureSorter.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Erst die Bausteine ohne Farbe (Abstände, Radien, Schrift), dann die
                     Farben. Die Reihenfolge sagt, was wovon abhängt: Nur Farben kippen
                     zwischen hell und dunkel. -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/AppColors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Das Programmsymbol in der Titelleiste. WinUI gibt ihm 16 Punkte; in der
                 48 Punkt hohen Leiste geht es damit unter.
                 Genau 32 und keine Zwischengröße: Die Symboldatei enthält feste Größen
                 (16, 24, 32, 48 …). Bei einem Zwischenwert nimmt WinUI ein kleineres Bild
                 und rechnet es hoch — das Symbol wird unscharf. Bei 32 trifft die
                 Anzeigegröße ein vorhandenes Bild Punkt für Punkt. -->
            <x:Double x:Key="TitleBarIconMaxWidth">32</x:Double>
            <x:Double x:Key="TitleBarIconMaxHeight">32</x:Double>

            <converters:PathToThumbnailConverter x:Key="ThumbnailConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:StatusSeverityToInfoBarSeverityConverter x:Key="StatusSeverityConverter" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
            <converters:StepReachedConverter x:Key="StepReachedConverter" />
            <converters:BoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverityConverter" />

            <!-- Karten-Optik: weiße (bzw. dunkle) abgerundete Fläche mit Rahmen,
                 abgesetzt von der Arbeitsfläche. Wird auf der Einstellungsseite und
                 im Sortier-Assistenten verwendet. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Kopfbereich einer Seite: Akzentfläche mit Titel und Kurzerklärung.
                 Gibt jeder Seite in einem Blick zu erkennen, worum es geht. -->
            <Style x:Key="HeroBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppHeroBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="20,16" />
            </Style>
            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AppHeroForegroundBrush}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- Volle Deckkraft: Bei 85 % mischte sich der Text mit dem Verlauf und kam
                 am hellen Anfang (#2E6DA4) nur auf 4,45:1 – knapp unter dem geforderten
                 Wert. Deckend sind es 5,5:1. Die Abstufung zum Titel trägt die
                 Schriftgröße, nicht die Durchsichtigkeit. -->
            <Style x:Key="HeroSubtitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AppHeroForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Überschrift eines Abschnitts innerhalb einer Karte. Die leichte Sperrung
                 kommt aus den Tokens: Sie unterscheidet die Überschrift vom Fließtext,
                 ohne dafür eine weitere Schriftgröße einzuführen. -->
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="{StaticResource SectionHeadingLetterSpacing}" />
            </Style>

            <!-- Anklickbare Kachel des Dashboards. -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="MinWidth" Value="240" />
                <Setter Property="MinHeight" Value="130" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <!-- Leerzustand: erklärt, was als Nächstes zu tun ist, statt leerer Fläche. -->
            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="420" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
