<!--
    Der Kopf jeder Listen-Seite: Titel, eine Zeile die sagt was man hier tut,
    Primäraktion rechts, darunter Suche und Filter.

    Ein Steuerelement statt derselben zwanzig Zeilen in jeder Ansicht. Die Reihenfolge
    liegt damit an einer Stelle fest und kann nicht von Seite zu Seite abweichen — genau
    darum geht es bei Wiedererkennung. Was eine Seite nicht mitgibt, blendet sich aus.
-->
<UserControl
    x:Class="PictureSorter.App.Controls.ListPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:converters="using:PictureSorter.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource SpacingM}">

        <!-- Titel und Primäraktion auf einer Höhe: was die Seite ist, und was man hier
             üblicherweise tut. -->
        <Grid>
            <StackPanel Spacing="{StaticResource SpacingXs}" VerticalAlignment="Center">
                <TextBlock
                    FontSize="{StaticResource FontSizeTitle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource AppTextMutedBrush}"
                    Text="{x:Bind Subtitle, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Subtitle, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <ContentPresenter
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="{x:Bind ActionContent, Mode=OneWay}" />
        </Grid>

        <!-- Suche links, Filter rechts. Die Suche bekommt festen Raum, die Filter den Rest. -->
        <Grid ColumnSpacing="{StaticResource SpacingM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:SearchBox
                x:Name="Search"
                Width="300"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Placeholder="{x:Bind SearchPlaceholder, Mode=OneWay}"
                SearchChanged="OnSearchChanged"
                Text="{x:Bind SearchText, Mode=TwoWay}"
                Visibility="{x:Bind SearchPlaceholder, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

            <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{x:Bind FilterContent, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
