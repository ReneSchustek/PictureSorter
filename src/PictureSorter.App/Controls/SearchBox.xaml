<!--
    Suchfeld der Gestaltungslinie: Lupe, Platzhalter, der sagt was durchsucht wird,
    Löschen bei gefülltem Feld, Escape leert.

    Aufgebaut auf dem AutoSuggestBox der Plattform statt als Nachbau: Lupe, Löschen und
    die Bedienung mit der Tastatur bringt es mit, und ein selbstgebautes Feld verhielte
    sich in Kleinigkeiten anders als der Rest von Windows.

    Die Suche meldet mit kurzer Verzögerung, nicht bei jedem Tastendruck: Bei tausenden
    Einträgen liefe sonst jede Taste über den ganzen Bestand.
-->
<UserControl
    x:Class="PictureSorter.App.Controls.SearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <AutoSuggestBox
        x:Name="Input"
        MinWidth="240"
        VerticalAlignment="Center"
        AutomationProperties.Name="{x:Bind Placeholder, Mode=OneWay}"
        PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
        QueryIcon="Find"
        Text="{x:Bind Text, Mode=TwoWay}"
        TextChanged="OnTextChanged" />
</UserControl>
