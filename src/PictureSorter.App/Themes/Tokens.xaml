<!--
    Bausteine der Gestaltungslinie, die nicht mit dem Erscheinungsbild wechseln:
    Abstände, Radien, Typografie, Kanten.

    Sie stehen hier und nicht in AppColors.xaml, weil dort ausschließlich Farben
    liegen — und nur Farben kippen zwischen hell und dunkel. Ansichten binden
    diese Werte über StaticResource; zur Laufzeit ändern sie sich nie.

    Maßgeblich ist F:\Entwicklung\_ai\rules\global\design-system.md. Wer einen
    Wert ändert, ändert ihn zuerst dort.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Abstände ──────────────────────────────────────────────────────────
         Eine Skala statt frei gewählter Zahlen: Gleiche Abstände sehen überall
         gleich aus, und eine Änderung wirkt an einer Stelle. Grundmaß ist 8. -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="StackGapS">0,0,0,8</Thickness>
    <Thickness x:Key="StackGapM">0,0,0,16</Thickness>

    <!-- ── Radien ────────────────────────────────────────────────────────────
         Klein halten: 4 bis 6. Nicht die weichen Radien der Dashboard-Mode —
         die Marke ist Industrie, nicht Spielzeug. -->
    <CornerRadius x:Key="AppControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="AppCardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="AppBadgeCornerRadius">6</CornerRadius>

    <!-- ── Typografie ────────────────────────────────────────────────────────
         Roboto Flex ist die Schrift der Marke; ohne sie trägt „Segoe UI
         Variable" (ab Windows 11) und danach „Segoe UI". Ohne diese Kette
         fällt die Anzeige auf eine Serifenschrift zurück. -->
    <FontFamily x:Key="AppFontFamily">Roboto Flex, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Roboto Mono, Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeader">28</x:Double>

    <!-- Abschnittsüberschriften: klein, in Großbuchstaben, gesperrt und
         gedämpft. Das ist das auffälligste Merkmal der Linie — es ersetzt
         große Zwischenüberschriften. -->
    <x:Int32 x:Key="SectionHeadingLetterSpacing">80</x:Int32>

    <!-- Zeilenhöhe im Fließtext: das 1,65-fache der Grundgröße. -->
    <x:Double x:Key="BodyLineHeight">21</x:Double>

    <!-- ── Kanten und Größen ─────────────────────────────────────────────────
         Flächen trennen sich über Farbe und eine Haarlinie, nicht über
         Schlagschatten. -->
    <Thickness x:Key="HairlineBorderThickness">1</Thickness>
    <x:Double x:Key="RowHeightDefault">36</x:Double>
    <x:Double x:Key="IconSizeS">14</x:Double>
    <x:Double x:Key="IconSizeM">18</x:Double>
    <x:Double x:Key="ThumbnailSizeS">56</x:Double>

</ResourceDictionary>
