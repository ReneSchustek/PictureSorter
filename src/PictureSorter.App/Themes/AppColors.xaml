<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Farbpalette von PictureSorter. Akzent ist das Stahlblau des Logos
        (#2E6DA4), abgestimmt mit der Marke „Ruhrcoder". Light und Dark teilen
        denselben Akzent-Charakter; im Dunkelmodus ist das Blau etwas heller,
        damit es auf dunklem Grund gut lesbar bleibt. Umgeschaltet wird über
        RequestedTheme am Wurzelelement (siehe ThemeService).
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ───────────────────────── Hell ───────────────────────── -->
        <ResourceDictionary x:Key="Light">
            <!-- Akzent (Buttons, Auswahl, Links) -->
            <Color x:Key="AppAccentColor">#2E6DA4</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2E6DA4" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3D83BB" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1F5A8A" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2E6DA4" />

            <!-- Arbeitsfläche und Karten -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E2E5EA" />
            <SolidColorBrush x:Key="AppStepActiveBrush" Color="#2E6DA4" />
            <SolidColorBrush x:Key="AppStepInactiveBrush" Color="#C3C9D2" />
            <SolidColorBrush x:Key="AppStepForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!-- ───────────────────────── Dunkel ───────────────────────── -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppAccentColor">#4A9CC5</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4A9CC5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5BB0D8" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3D83BB" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4A9CC5" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1A1D21" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#262A30" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#363B43" />
            <SolidColorBrush x:Key="AppStepActiveBrush" Color="#4A9CC5" />
            <SolidColorBrush x:Key="AppStepInactiveBrush" Color="#4A5160" />
            <SolidColorBrush x:Key="AppStepForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
