<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Farben der Gestaltungslinie. Die Werte stammen aus der Marke und nicht aus
        diesem Projekt — maßgeblich ist F:\Entwicklung\_ai\rules\global\design-system.md.

        Beide Belegungen führen denselben Satz Schlüssel. Fehlt einer in einer
        Belegung, bricht die Bindung genau dort — und das fällt erst beim Nutzer
        auf, nicht beim Entwickeln. Ein Test hält das fest.

        Die Primärfläche ist immer der Gegensatz zum Hintergrund: im Hellen dunkles
        Petrol mit weißer Schrift, im Dunklen helles Stahlgrau mit dunkler Schrift.
        Deshalb kippt der Text auf ihr mit — dafür gibt es eigene Schlüssel.
        Umgeschaltet wird über RequestedTheme am Wurzelelement (siehe ThemeService).
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ───────────────────────── Hell ───────────────────────── -->
        <ResourceDictionary x:Key="Light">
            <!-- Akzent (Schaltflächen, Auswahl, Verweise) -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2F4858" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3A5A6E" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D2B38" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#A8B8C2" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2D7FA8" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2F4858" />

            <!-- Text auf der Primärfläche: im Hellen weiß auf dunklem Petrol. -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#DDE5E9" />

            <!-- Arbeitsfläche und Karten -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="AppCardBorderHoverBrush" Color="#2F4858" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#EBEBEB" />

            <!-- Text -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#DCDCDC" />

            <!-- Navigationsleiste: dunkel gegen die helle Arbeitsfläche. Die Werte
                 gelten in beiden Belegungen ähnlich, damit die Leiste ihren
                 Charakter behält. Kontrast Text (#F5F5F5) auf Fläche (#0D2B38):
                 über 14:1 und damit weit über der Anforderung. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0D2B38" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0D2B38" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2F4858" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2F4858" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3A5A6E" />

            <!-- Kopfbereich: eine ruhige Fläche in der Primärfarbe. Der frühere
                 Verlauf ist bewusst entfallen — die Linie kennt keine Effekte,
                 die Tiefe vortäuschen. -->
            <SolidColorBrush x:Key="AppHeroBrush" Color="#2F4858" />
            <SolidColorBrush x:Key="AppHeroForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!-- ───────────────────────── Dunkel ───────────────────────── -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C5D0D6" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDE5E9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#94A3AB" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3A464F" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#DDE5E9" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#C5D0D6" />

            <!-- Im Dunklen ist die Primärfläche hell und trägt dunkle Schrift.
                 Ein gemeinsamer „Invers"-Wert für beide Belegungen ergäbe hier
                 Weiß auf Hellgrau — unlesbar. Kontrast #0F1923 auf #C5D0D6: 11,6:1. -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0F1923" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2A343D" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1923" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#152030" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#28323F" />
            <SolidColorBrush x:Key="AppCardBorderHoverBrush" Color="#C5D0D6" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#1A2535" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#E4EDF2" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#8AA3B0" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#28323F" />

            <!-- Die Leiste setzt sich hier durch eine noch dunklere Fläche ab.
                 Kontrast Text (#E4EDF2) auf Fläche (#0A121A): über 15:1. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0A121A" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0A121A" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E4EDF2" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#0F1923" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#0F1923" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A2535" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#C5D0D6" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#DDE5E9" />

            <SolidColorBrush x:Key="AppHeroBrush" Color="#C5D0D6" />
            <SolidColorBrush x:Key="AppHeroForegroundBrush" Color="#0F1923" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
