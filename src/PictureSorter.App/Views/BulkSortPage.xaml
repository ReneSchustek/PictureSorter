<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.BulkSortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ListPageHeader x:Uid="BulkPage_Header" />

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel
                MaxWidth="980"
                HorizontalAlignment="Left"
                Spacing="16">

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="BulkPage_FolderHeading"
                            Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock
                            x:Uid="BulkPage_FolderHint"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="BulkPage_SourceBox"
                                Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                x:Uid="BulkPage_PickSource"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.PickSourceFolderCommand}" />
                        </Grid>

                        <TextBox
                            x:Uid="BulkPage_NewFoldersBox"
                            Text="{x:Bind ViewModel.NewFolderNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            x:Uid="BulkPage_Analyze"
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="BulkPage_PreviewHeading"
                            Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock
                            x:Uid="BulkPage_PreviewHint"
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextMutedBrush}"
                            Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Notes, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ListView
                            x:Uid="BulkPage_ProposalList"
                            MaxHeight="420"
                            ItemsSource="{x:Bind ViewModel.Items}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Width="56"
                                            Height="56"
                                            AutomationProperties.Name="{x:Bind FileName}"
                                            Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                            Stretch="UniformToFill" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                                            Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppTextMutedBrush}"
                                            Text="{x:Bind ScoreText, Mode=OneWay}" />
                                        <ComboBox
                                            Grid.Column="3"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind FileName}"
                                            ItemsSource="{x:Bind Choices}"
                                            SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <CheckBox
                            x:Uid="BulkPage_CopyCheck"
                            IsChecked="{x:Bind ViewModel.CopyInsteadOfMove, Mode=TwoWay}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="BulkPage_TargetRootBox"
                                Text="{x:Bind ViewModel.TargetRootFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                x:Uid="BulkPage_PickTargetRoot"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.PickTargetRootCommand}" />
                        </Grid>

                        <Button
                            x:Uid="BulkPage_Apply"
                            Command="{x:Bind ViewModel.ApplyCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
