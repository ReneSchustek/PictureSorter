<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Titel und Erklärung -->
        <Border Margin="24,16,24,8" Style="{StaticResource HeroBorderStyle}">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="MemoryPage_HeroTitle"
                    Style="{StaticResource HeroTitleStyle}"
                    Text="Gedächtnis" />
                <TextBlock
                    x:Uid="MemoryPage_HeroSubtitle"
                    Style="{StaticResource HeroSubtitleStyle}"
                    Text="Was sich PictureSorter gemerkt hat. Gemerkte Fotos werden beim nächsten Sortieren übersprungen – vergisst du einen Eintrag, wird das Foto wieder neu bewertet." />
            </StackPanel>
        </Border>

        <!-- Filter und Aktionen -->
        <Grid
            Grid.Row="1"
            Padding="24,8,24,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Uid="MemoryPage_FolderFilter"
                MinWidth="220"
                AutomationProperties.Name="Nach Ordner filtern"
                Header="Ordner"
                ItemsSource="{x:Bind ViewModel.Folders}"
                SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}" />
            <ComboBox
                x:Uid="MemoryPage_CategoryFilter"
                Grid.Column="1"
                MinWidth="180"
                AutomationProperties.Name="Nach Kategorie filtern"
                Header="Kategorie"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

            <Button
                x:Uid="MemoryPage_ClearFolderButton"
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ClearFolderCommand}"
                Content="Ordner vergessen"
                ToolTipService.ToolTip="Verwirft alle gemerkten Entscheidungen des oben gewählten Ordners." />
            <Button
                x:Uid="MemoryPage_RefreshButton"
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="Aktualisieren" />
        </Grid>

        <!-- Leerzustand -->
        <StackPanel
            Grid.Row="2"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                x:Uid="MemoryPage_EmptyStateTitle"
                Style="{StaticResource EmptyStateTitleStyle}"
                Text="Noch nichts gemerkt" />
            <TextBlock
                x:Uid="MemoryPage_EmptyStateText"
                Style="{StaticResource EmptyStateTextStyle}"
                Text="Sobald du zum ersten Mal sortierst, erscheinen hier die Entscheidungen." />
        </StackPanel>

        <!-- Liste der gemerkten Entscheidungen -->
        <ListView
            Grid.Row="2"
            Padding="24,4,24,16"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SortMemoryItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="48"
                            Height="48"
                            AutomationProperties.Name="{x:Bind FileName}"
                            Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                            Stretch="UniformToFill" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind FolderPath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CategoryName}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind UpdatedText}" />
                        </StackPanel>

                        <Button
                            x:Uid="MemoryPage_ForgetItemButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Diesen Eintrag vergessen"
                            Click="OnDeleteClick"
                            Content="Vergessen"
                            Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
