<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Der Kopf der Linie: Titel, was man hier tut, dann Suche und Filter. Die
             Anordnung liegt im Baustein fest und kann von Seite zu Seite nicht abweichen. -->
        <controls:ListPageHeader
            x:Name="Header"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="24,16,24,8"
            SearchChanged="OnSearchChanged"
            x:Uid="MemoryPage_Header">
            <controls:ListPageHeader.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Uid="MemoryPage_FolderFilter"
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.Folders}"
                        SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}" />
                    <ComboBox
                        x:Uid="MemoryPage_CategoryFilter"
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.Categories}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
                    <Button
                        x:Uid="MemoryPage_ClearFolderButton"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ClearFolderCommand}" />
                    <Button
                        x:Uid="MemoryPage_RefreshButton"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </controls:ListPageHeader.FilterContent>
        </controls:ListPageHeader>

        <!-- Leerzustand. „Nichts vorhanden" und „nichts gefunden" sind zwei Lagen und
             brauchen zwei Sätze; im zweiten Fall gehört der Weg zurück dazu. -->
        <controls:EmptyState
            Grid.Row="2"
            x:Uid="MemoryPage_EmptyState"
            ResetRequested="OnResetSearch"
            Visibility="{x:Bind ViewModel.ShowsNothingYet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <controls:EmptyState
            Grid.Row="2"
            x:Uid="MemoryPage_NoMatchState"
            ResetRequested="OnResetSearch"
            Visibility="{x:Bind ViewModel.ShowsNoMatch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Liste der gemerkten Entscheidungen -->
        <ListView
            x:Uid="MemoryPage_ItemList"
            Grid.Row="2"
            Padding="24,4,24,16"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SortMemoryItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="48"
                            Height="48"
                            AutomationProperties.Name="{x:Bind FileName}"
                            Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                            Stretch="UniformToFill" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind FolderPath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CategoryName}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind UpdatedText}" />
                        </StackPanel>

                        <Button
                            x:Uid="MemoryPage_ForgetItemButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Click="OnDeleteClick"
                            Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
