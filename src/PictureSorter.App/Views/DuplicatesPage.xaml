<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.Application.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Duplikate finden" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Ordner"
                    PlaceholderText="z. B. C:\Fotos"
                    Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.BrowseCommand}"
                    Content="Durchsuchen…" />
            </Grid>
            <CheckBox
                Content="Unterordner einbeziehen"
                IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Duplikate suchen"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button Command="{x:Bind ViewModel.DeleteSelectedCommand}" Content="Ausgewählte in den Papierkorb" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Header}" />
                            <GridView
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind Photos}"
                                SelectionMode="None">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicatePhotoViewModel">
                                        <StackPanel
                                            Width="190"
                                            Padding="6"
                                            Spacing="4">
                                            <Image
                                                Height="140"
                                                AutomationProperties.Name="{x:Bind FileName}"
                                                Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                Stretch="UniformToFill"
                                                ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                            <TextBlock
                                                MaxWidth="178"
                                                FontSize="12"
                                                Text="{x:Bind FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SizeText}" />
                                            <TextBlock
                                                MaxWidth="178"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind MetadataText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <CheckBox
                                                Content="Löschen"
                                                IsChecked="{x:Bind IsMarkedForDeletion, Mode=TwoWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
