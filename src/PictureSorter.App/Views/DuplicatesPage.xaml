<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource AppBackgroundBrush}"
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <!-- Der Kopf der Linie: Titel, was man hier tut, dann Suche und Filter.
                 Dieselbe Anordnung wie auf jeder anderen Listen-Seite.

                 Der Name heißt PageHeader, nicht Header: Weiter unten trägt ein Eingabefeld
                 die Eigenschaft Header. Beides zugleich lässt den XAML-Übersetzer abstürzen,
                 und zwar ohne verwertbare Meldung. -->
            <controls:ListPageHeader
                x:Name="PageHeader"
                x:Uid="DuplicatesPage_Header"
                SearchChanged="OnSearchChanged">
                <controls:ListPageHeader.FilterContent>
                    <controls:FilterChips
                        x:Uid="DuplicatesPage_Filter"
                        Options="{x:Bind ViewModel.Filters}"
                        SelectionChanged="OnFilterChanged" />
                </controls:ListPageHeader.FilterContent>
            </controls:ListPageHeader>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="DuplicatesPage_FolderTextBox"
                    Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="DuplicatesPage_BrowseButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.BrowseCommand}" />
            </Grid>
            <CheckBox
                x:Uid="DuplicatesPage_IncludeSubfoldersCheckBox"
                IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="DuplicatesPage_ScanButton"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    x:Uid="DuplicatesPage_DeleteSelectedButton"
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Eine ListView statt ScrollViewer+ItemsControl: Nur sie virtualisiert. Ohne
             Virtualisierung entstünde jede gefundene Gruppe sofort, bei einem Ordner mit vielen
             Duplikaten hunderte Gruppen mit tausenden Vorschaubildern auf einen Schlag.
             Die Oberfläche stünde dabei minutenlang, und ab einigen hundert Gruppen bräche
             der Aufbau mit „Layout cycle detected" ab.

             Innen ein ItemsRepeater statt einer GridView: Eine GridView bringt einen
             eigenen ScrollViewer mit. In der unbegrenzten Höhe des äußeren ScrollViewers
             konnte ihre Messung nicht zur Ruhe kommen. Genau das war der Layout-Zyklus.
             Der ItemsRepeater legt die Kacheln ohne eigenen Scroller aus. -->
        <controls:EmptyState
            x:Uid="DuplicatesPage_NoMatch"
            Grid.Row="1"
            ResetRequested="OnResetSearch"
            Visibility="{x:Bind ViewModel.ShowsNoMatch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Groups}"
            ScrollViewer.HorizontalScrollMode="Disabled"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <!-- Der Name der Fundgruppe gehört an den Rahmen: Ohne ihn liest
                             die Sprachausgabe den Namen der Anzeige-Klasse vor. -->
                        <StackPanel
                            Margin="{StaticResource StackGapM}"
                            AutomationProperties.Name="{x:Bind Header}"
                            Spacing="{StaticResource SpacingS}">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                Text="{x:Bind Header}" />
                            <ItemsRepeater ItemsSource="{x:Bind Photos}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinColumnSpacing="8"
                                        MinItemHeight="300"
                                        MinItemWidth="190"
                                        MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicatePhotoViewModel">
                                        <controls:PhotoTile
                                            Width="190"
                                            Margin="{StaticResource TileGap}"
                                            Details="{x:Bind SizeText}"
                                            FileName="{x:Bind FileName}"
                                            Hint="{x:Bind InfoTooltip}"
                                            ImagePath="{x:Bind FilePath}"
                                            Opened="OnPhotoOpened"
                                            PreviewHeight="140"
                                            Tag="{x:Bind}">
                                            <controls:PhotoTile.ActionContent>
                                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource AppTextMutedBrush}"
                                                        Text="{x:Bind MetadataText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <CheckBox
                                                        x:Uid="DuplicatesPage_DeleteCheckBox"
                                                        AutomationProperties.Name="{x:Bind DeletionLabel, Mode=OneWay}"
                                                        IsChecked="{x:Bind IsMarkedForDeletion, Mode=TwoWay}"
                                                        IsEnabled="{x:Bind CanToggleDeletion, Mode=OneWay}" />
                                                    <TextBlock
                                                        x:Uid="DuplicatesPage_LastCopyHint"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource AppTextMutedBrush}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind IsLastRemainingCopy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </controls:PhotoTile.ActionContent>
                                        </controls:PhotoTile>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
