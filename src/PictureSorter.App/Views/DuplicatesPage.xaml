<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource AppBackgroundBrush}"
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <!-- Der Kopf der Linie: Titel, was man hier tut, dann Suche und Filter.
                 Dieselbe Anordnung wie auf jeder anderen Listen-Seite.

                 Der Name heißt PageHeader, nicht Header: Weiter unten trägt ein Eingabefeld
                 die Eigenschaft Header. Beides zugleich lässt den XAML-Übersetzer abstürzen,
                 und zwar ohne verwertbare Meldung. -->
            <controls:ListPageHeader
                x:Name="PageHeader"
                x:Uid="DuplicatesPage_Header"
                SearchChanged="OnSearchChanged"
                SearchPlaceholder="Dateiname oder Ordner"
                Subtitle="Findet gleiche und sehr ähnliche Bilder. Gelöschte Dateien landen im Papierkorb und bleiben wiederherstellbar."
                Title="Duplikate finden">
                <controls:ListPageHeader.FilterContent>
                    <controls:FilterChips
                        x:Uid="DuplicatesPage_Filter"
                        Label="Fundgruppen filtern"
                        Options="{x:Bind ViewModel.Filters}"
                        SelectionChanged="OnFilterChanged" />
                </controls:ListPageHeader.FilterContent>
            </controls:ListPageHeader>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="DuplicatesPage_FolderTextBox"
                    Header="Ordner"
                    PlaceholderText="z. B. C:\Fotos"
                    Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay}" />
                <Button
                    x:Uid="DuplicatesPage_BrowseButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.BrowseCommand}"
                    Content="Durchsuchen…" />
            </Grid>
            <CheckBox
                x:Uid="DuplicatesPage_IncludeSubfoldersCheckBox"
                Content="Unterordner einbeziehen"
                IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="DuplicatesPage_ScanButton"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Duplikate suchen"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    x:Uid="DuplicatesPage_DeleteSelectedButton"
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                    Content="Ausgewählte in den Papierkorb" />
            </StackPanel>
        </StackPanel>

        <!-- Eine ListView statt ScrollViewer+ItemsControl: Nur sie virtualisiert. Vorher
             wurde jede gefundene Gruppe sofort erzeugt – bei einem Ordner mit vielen
             Duplikaten hunderte Gruppen mit tausenden Vorschaubildern auf einen Schlag.
             Die Oberfläche stand dabei minutenlang, und ab einigen hundert Gruppen brach
             der Aufbau mit „Layout cycle detected" ab.

             Innen ein ItemsRepeater statt einer GridView: Eine GridView bringt einen
             eigenen ScrollViewer mit. In der unbegrenzten Höhe des äußeren ScrollViewers
             konnte ihre Messung nicht zur Ruhe kommen – genau das war der Layout-Zyklus.
             Der ItemsRepeater legt die Kacheln ohne eigenen Scroller aus. -->
        <controls:EmptyState
            x:Uid="DuplicatesPage_NoMatch"
            Grid.Row="1"
            Message="Zu dieser Suche gibt es keine Fundgruppe. Vielleicht ist der Filter zu eng gesetzt."
            ResetLabel="Suche zurücksetzen"
            ResetRequested="OnResetSearch"
            Title="Nichts gefunden"
            Visibility="{x:Bind ViewModel.ShowsNoMatch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Groups}"
            ScrollViewer.HorizontalScrollMode="Disabled"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Header}" />
                            <ItemsRepeater ItemsSource="{x:Bind Photos}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinColumnSpacing="8"
                                        MinItemHeight="300"
                                        MinItemWidth="190"
                                        MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicatePhotoViewModel">
                                        <StackPanel
                                            Width="190"
                                            Padding="6"
                                            Spacing="4">
                                            <Image
                                                Height="140"
                                                AutomationProperties.Name="{x:Bind FileName}"
                                                Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                Stretch="UniformToFill"
                                                ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                            <TextBlock
                                                MaxWidth="178"
                                                FontSize="12"
                                                Text="{x:Bind FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SizeText}" />
                                            <TextBlock
                                                MaxWidth="178"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind MetadataText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <CheckBox
                                                x:Uid="DuplicatesPage_DeleteCheckBox"
                                                Content="Löschen"
                                                AutomationProperties.Name="{x:Bind DeletionLabel, Mode=OneWay}"
                                                IsChecked="{x:Bind IsMarkedForDeletion, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanToggleDeletion, Mode=OneWay}" />
                                            <TextBlock
                                                x:Uid="DuplicatesPage_LastCopyHint"
                                                MaxWidth="178"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind IsLastRemainingCopy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
