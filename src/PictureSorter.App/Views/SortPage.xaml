<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.SortPage"
    x:Name="SortPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PictureSorter.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Immer sichtbar: KI-Hinweis, Titel und Ansichts-Umschalter -->
        <StackPanel Padding="24,16,24,8" Spacing="12">
            <InfoBar
                x:Uid="SortPage_ModelHintBar"
                IsClosable="False"
                IsOpen="{x:Bind ModelHint.IsHintVisible, Mode=OneWay}"
                Message="{x:Bind ModelHint.Message, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Uid="SortPage_SetupOllamaButton" Click="OnSetupOllamaClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--
                Rückgängig-Hinweis. Bewusst hier oben und nicht in der Schritt-5-Karte:
                Der Lauf steht dauerhaft im Protokoll, also soll er auch nach einem
                Neustart oder auf Schritt 1 noch zurückzunehmen sein.
            -->
            <InfoBar
                x:Uid="SortPage_UndoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasUndoableRun, Mode=OneWay}"
                Message="{x:Bind ViewModel.UndoSummary, Mode=OneWay}"
                Severity="Success">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="SortPage_UndoButton"
                        Command="{x:Bind ViewModel.UndoCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--
                Angebot, einen protokollierten Analyselauf fortzusetzen oder sein Ergebnis
                zurückzuholen. Steht neben dem Rückgängig-Hinweis und aus demselben Grund
                oben: Ein Lauf über tausende Bilder dauert Stunden bis Tage und übersteht
                einen Neustart nur, weil er im Protokoll steht.
            -->
            <InfoBar
                x:Uid="SortPage_ResumeBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.Resume.HasRun, Mode=OneWay}"
                Message="{x:Bind ViewModel.Resume.Summary, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="SortPage_ResumeButton"
                        Command="{x:Bind ViewModel.Resume.ResumeCommand}"
                        Content="{x:Bind ViewModel.Resume.ActionLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </InfoBar.ActionButton>

                <!-- Der zweite Weg gehört sichtbar daneben: Wer neu anfangen will, soll
                     nicht raten müssen, wie er den Hinweis loswird. -->
                <Button
                    Margin="0,8,0,8"
                    x:Uid="SortPage_DiscardRunButton"
                    Command="{x:Bind ViewModel.Resume.DiscardCommand}" />
            </InfoBar>

            <!--
                Frühere Urteile aus dem Sortier-Gedächtnis. Sie erreichen den Weg über das
                Protokoll nicht, weil es zu Läufen aus älteren Fassungen keines gibt, und
                weil ein abgestürzter Lauf trotzdem jedes gefällte Urteil hinterlassen hat.

                Die Leiste erscheint nur, wenn wirklich etwas bereitliegt, und nennt die
                Anzahl. Ein Knopf, der bei den meisten Läufen „nichts gemerkt" meldet, wäre
                keine Hilfe, sondern eine Sackgasse mit Beschriftung. Sie steht hier oben
                und nicht in einer Schritt-Karte: Zum Nachschlagen braucht es weder
                Beispiele noch ein gelerntes Profil, nur Ordner und Gruppenname.
            -->
            <InfoBar
                x:Uid="SortPage_RecoverBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowsRecoverOffer, Mode=OneWay}"
                Message="{x:Bind ViewModel.RecoverOfferSummary, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="SortPage_RecoverButton"
                        Command="{x:Bind ViewModel.Resume.RecoverFromMemoryCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRecoverFromMemory, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource HeroBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Uid="SortPage_HeroTitle" Style="{StaticResource HeroTitleStyle}" />
                        <TextBlock
                            x:Uid="SortPage_HeroSubtitle"
                            Style="{StaticResource HeroSubtitleStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="SortPage_ViewModeLabel" />
                    <ComboBox
                        x:Name="ViewModeCombo"
                        x:Uid="SortPage_ViewModeCombo"
                        MinWidth="170"
                        SelectionChanged="OnViewModeChanged">
                        <ComboBoxItem x:Uid="SortPage_ViewModeStepByStep" />
                        <ComboBoxItem x:Uid="SortPage_ViewModeStandard" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Nur im Schritt-für-Schritt-Modus: klickbare Schrittleiste + Titel + Neustart -->
        <StackPanel
            Grid.Row="1"
            Padding="24,0,24,8"
            Spacing="6"
            Visibility="{x:Bind ViewModel.Wizard.IsGuided, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Schrittleiste: Sprung zu bereits erreichten Schritten. Der ContentControl
                 deaktiviert die ganze Leiste, während ein Vorgang läuft. -->
            <ContentControl
                HorizontalContentAlignment="Left"
                IsEnabled="{x:Bind ViewModel.Wizard.IsInteractive, Mode=OneWay}"
                IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="2">
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step1Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep1, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=0}"
                    Tag="0" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step2Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep2, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=1}"
                    Tag="1" />
                <!-- Die beiden Schritte zur Beispielauswahl entfallen, wenn allein nach
                     Aufnahmedatum sortiert wird: Dann gibt es nichts anzulernen. -->
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸"
                    Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step3Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep3, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=2}"
                    Tag="2"
                    Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸"
                    Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step4Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep4, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=3}"
                    Tag="3"
                    Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step5Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep5, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=4}"
                    Tag="4" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step6Link"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep6, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=5}"
                    Tag="5" />
                </StackPanel>
            </ContentControl>

            <!-- Titel des aktuellen Schritts + Neu starten -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Wizard.StepTitle, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.Wizard.RestartCommand}"
                    x:Uid="SortPage_RestartButton" />
            </Grid>
        </StackPanel>

        <!-- Inhalt: Schritt-Karten. Im Schritt-Modus nur die aktive, im Standard alle. -->
        <ScrollViewer Grid.Row="2" Padding="24,4,24,12">
            <StackPanel MaxWidth="840" Spacing="16">

                <!-- Schritt 1: Quellordner -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step1Heading" FontWeight="SemiBold" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step1Description"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- UpdateSourceTrigger wie beim Gruppennamen: Ohne die
                                 Angabe schreibt WinUI den Text erst beim Verlassen des
                                 Feldes ins Anzeige-Modell. „Weiter" hängt aber am
                                 Ordner. Es bliebe grau, solange die Nutzerin im Feld
                                 steht, und niemand käme auf die Idee, erst woanders
                                 hinzuklicken. -->
                            <TextBox
                                x:Uid="SortPage_SourceFolderBox"
                                Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseCommand}"
                                x:Uid="SortPage_BrowseButton" />
                        </Grid>
                        <CheckBox
                            x:Uid="SortPage_IncludeSubfoldersCheck"
                            IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Schritt 2: Kategorie beschreiben -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step2Heading" FontWeight="SemiBold" />

                        <!-- Die Wahl des Weges steht bewusst hier und nicht erst beim
                             Zeitraum: Sie entscheidet darüber, ob überhaupt Beispiele
                             gesammelt werden müssen. Weiter hinten gestellt, hätte die
                             Nutzerin dreißig Bilder umsonst angelernt. -->
                        <CheckBox
                            x:Uid="SortPage_SortModeByDateCheck"
                            IsChecked="{x:Bind ViewModel.SortByDateOnly, Mode=TwoWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_SortModeByDateHint"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step2Description"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- UpdateSourceTrigger: Ohne die Angabe schreibt WinUI den Text
                             erst beim Verlassen des Feldes ins Anzeige-Modell. Das Angebot,
                             frühere Urteile zurückzuholen, hängt am Gruppennamen; es
                             erschiene sonst erst, wenn die Nutzerin woanders hinklickt,
                             und bis dahin sieht sie es nicht. -->
                        <TextBox
                            x:Uid="SortPage_CategoryNameBox"
                            Text="{x:Bind ViewModel.CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Beschreibung und Ereignis-Kennzeichen wirken ausschließlich auf
                             die KI-Bewertung; beim Sortieren nach Datum wären sie zwei
                             Felder ohne jede Wirkung. -->
                        <TextBox
                            x:Uid="SortPage_CategoryDescriptionBox"
                            AcceptsReturn="True"
                            Text="{x:Bind ViewModel.CategoryDescription, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox
                            x:Uid="SortPage_EventCategoryCheck"
                            IsChecked="{x:Bind ViewModel.IsEventCategory, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowExampleSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Schritt 3: Bilder, die zur Gruppe gehören -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step3Heading" FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="SortPage_Step3Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PositiveExamples.CapacityText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="SortPage_SuggestPositivesButton"
                                Command="{x:Bind ViewModel.SuggestPositivesCommand}" />
                            <Button
                                x:Uid="SortPage_PickPositivesButton"
                                Command="{x:Bind ViewModel.PickPositivesCommand}" />
                        </StackPanel>
                        <Border
                            Padding="8"
                            AllowDrop="True"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCardCornerRadius}"
                            DragOver="OnPositivesDragOver"
                            Drop="OnPositivesDrop">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="SortPage_DropHint"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <GridView
                                    x:Uid="SortPage_PositiveExampleList"
                                    MaxHeight="320"
                                    ItemsSource="{x:Bind ViewModel.PositiveExamples.Items}"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExampleCandidateViewModel">
                                            <controls:PhotoTile
                                                Width="170"
                                                Margin="{StaticResource TileGap}"
                                                FileName="{x:Bind FileName}"
                                                Hint="{x:Bind InfoTooltip}"
                                                ImagePath="{x:Bind FilePath}"
                                                Opened="OnExampleOpened"
                                                PreviewHeight="120"
                                                Tag="{x:Bind}">
                                                <controls:PhotoTile.ActionContent>
                                                    <Button
                                                        x:Uid="SortPage_RemoveExampleButton"
                                                        Padding="{StaticResource TileGap}"
                                                        Command="{Binding ViewModel.PositiveExamples.RemoveCommand, ElementName=SortPageRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        FontSize="{StaticResource FontSizeCaption}" />
                                                </controls:PhotoTile.ActionContent>
                                            </controls:PhotoTile>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Schritt 4: Bilder, die ausdrücklich NICHT dazugehören -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep4, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step4Heading" FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="SortPage_Step4Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.NegativeExamples.CapacityText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="SortPage_SuggestNegativesButton"
                                Command="{x:Bind ViewModel.SuggestNegativesCommand}" />
                            <Button
                                x:Uid="SortPage_PickNegativesButton"
                                Command="{x:Bind ViewModel.PickNegativesCommand}" />
                            <Button
                                x:Uid="SortPage_LearnButton"
                                Command="{x:Bind ViewModel.LearnCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Border
                            Padding="8"
                            AllowDrop="True"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCardCornerRadius}"
                            DragOver="OnNegativesDragOver"
                            Drop="OnNegativesDrop">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="SortPage_DropHintNegative"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <GridView
                                    x:Uid="SortPage_NegativeExampleList"
                                    MaxHeight="320"
                                    ItemsSource="{x:Bind ViewModel.NegativeExamples.Items}"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExampleCandidateViewModel">
                                            <controls:PhotoTile
                                                Width="170"
                                                Margin="{StaticResource TileGap}"
                                                FileName="{x:Bind FileName}"
                                                Hint="{x:Bind InfoTooltip}"
                                                ImagePath="{x:Bind FilePath}"
                                                Opened="OnExampleOpened"
                                                PreviewHeight="120"
                                                Tag="{x:Bind}">
                                                <controls:PhotoTile.ActionContent>
                                                    <Button
                                                        x:Uid="SortPage_RemoveExampleButton"
                                                        Padding="{StaticResource TileGap}"
                                                        Command="{Binding ViewModel.NegativeExamples.RemoveCommand, ElementName=SortPageRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        FontSize="{StaticResource FontSizeCaption}" />
                                                </controls:PhotoTile.ActionContent>
                                            </controls:PhotoTile>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>
                        <TextBlock>
                            <Run x:Uid="SortPage_ActiveGroupLabel" />
                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveCategoryName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Schritt 5: Analyse starten -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep5, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step5Heading" FontWeight="SemiBold" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step5Description"
                            TextWrapping="Wrap" />

                        <!-- Zeitraum: schränkt die Analyse ein, bevor der teure Teil
                             beginnt. Fotos außerhalb kommen der KI gar nicht erst vor. -->
                        <TextBlock
                            x:Uid="SortPage_DateRangeHeading"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="SortPage_DateRangeDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DatePicker
                                x:Uid="SortPage_DateFromPicker"
                                SelectedDate="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                            <DatePicker
                                x:Uid="SortPage_DateToPicker"
                                SelectedDate="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
                            <Button
                                x:Uid="SortPage_ClearDateRangeButton"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ClearDateRangeCommand}" />
                        </StackPanel>

                        <!-- Urlaube vorschlagen: reine Rechnerei auf den Aufnahmedaten,
                             ohne KI. Wo zwischen zwei Aufnahmen eine längere Pause liegt,
                             endet ein Zeitraum. -->
                        <Button
                            x:Uid="SortPage_SuggestTripsButton"
                            Command="{x:Bind ViewModel.SuggestTripsCommand}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TripHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.TripHint, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TripSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TripSuggestionViewModel">
                                    <HyperlinkButton
                                        Command="{Binding ElementName=SortPageRoot, Path=ViewModel.UseTripSuggestionCommand}"
                                        CommandParameter="{x:Bind}"
                                        Content="{x:Bind Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- In der Standard-Ansicht trägt die Karte ihren eigenen Knopf.
                             Welcher der beiden gilt, hängt am gewählten Weg: Der eine legt
                             jedes Foto der KI vor, der andere sieht nur auf das Datum. -->
                        <Button
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            x:Uid="SortPage_AnalyzeButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowStandardAnalyzeAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Command="{x:Bind ViewModel.SortByDateCommand}"
                            x:Uid="SortPage_FindByDateButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowStandardDateAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Während des Laufs: anhalten. Bewusst hier und nicht nur als
                             Stopp in der Statusleiste, denn bei einem Lauf über Stunden ist
                             das die Frage, die sich stellt, und die Nutzerin muss sehen,
                             dass dabei nichts verlorengeht. -->
                        <StackPanel
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button
                                Command="{x:Bind ViewModel.CancelCommand}"
                                x:Uid="SortPage_PauseButton"
                                Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="SortPage_PauseHint"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Schritt 6: Vorschau und Sortieren -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep6, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step6Heading" FontWeight="SemiBold" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step6Description"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_BackupHint"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Command="{x:Bind ViewModel.Proposals.ToggleAllCommand}"
                                x:Uid="SortPage_ToggleAllButton" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Proposals.SelectionSummary, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ApplyCommand}"
                                x:Uid="SortPage_ApplyButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <!-- Steht bewusst direkt über dem Sortieren-Knopf: Der Weg, auf dem
                             die Fotos ihren Ordner erreichen, gehört dorthin, wo man ihn
                             auslöst, nicht in eine Einstellungsseite. -->
                        <CheckBox
                            x:Uid="SortPage_CopyInsteadOfMoveCheck"
                            IsChecked="{x:Bind ViewModel.CopyInsteadOfMove, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Suche und Filter über der Vorschau. Bei einem Ordner mit
                             tausenden Fotos ist eine Liste ohne sie nicht durchzusehen,
                             und genau dort entsteht sie. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:SearchBox
                                x:Name="ProposalSearch"
                                Width="260"
                                x:Uid="SortPage_ProposalSearch"
                                SearchChanged="OnProposalSearchChanged" />
                            <controls:FilterChips
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                x:Uid="SortPage_ProposalFilter"
                                Options="{x:Bind ViewModel.Proposals.Filters}"
                                SelectionChanged="OnProposalFilterChanged" />
                        </Grid>

                        <!-- „Nichts gefunden" ist eine andere Lage als „nichts da": Der
                             Bestand ist vorhanden, nur die Suche trifft ihn nicht. -->
                        <controls:EmptyState
                            x:Uid="SortPage_ProposalNoMatch"
                            ResetRequested="OnProposalSearchReset"
                            Visibility="{x:Bind ViewModel.Proposals.ShowsNoMatch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ListView
                            x:Uid="SortPage_ProposalList"
                            MaxHeight="360"
                            ItemsSource="{x:Bind ViewModel.Proposals.Items}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProposalViewModel">
                                    <Grid
                                        Padding="0,6"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            x:Uid="SortPage_ProposalSelectCheck" />
                                        <!-- Klick auf das Bild öffnet die Großansicht. -->
                                        <Button
                                            x:Uid="SortPage_ProposalImageButton"
                                            Grid.Column="1"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnProposalImageClick"
                                            Tag="{x:Bind}">
                                            <Image
                                                Width="56"
                                                Height="56"
                                                AutomationProperties.Name="{x:Bind FileName}"
                                                Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                Stretch="UniformToFill"
                                                ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                        </Button>

                                        <!-- Die Lupe neben dem Bildchen: In 56 Bildpunkten
                                             erkennt man, was darauf ist, aber nicht, ob es
                                             etwas taugt. Sie zeigt es in einem eigenen,
                                             frei skalierbaren Fenster. Der Klick auf das
                                             Bild führt weiterhin zu seinen Angaben. -->
                                        <Button
                                            Grid.Column="2"
                                            Padding="{StaticResource TileGap}"
                                            VerticalAlignment="Center"
                                            x:Uid="SortPage_ProposalZoomButton"
                                            Click="OnProposalZoomClick"
                                            Tag="{x:Bind}">
                                            <FontIcon FontSize="{StaticResource FontSizeCaption}" Glyph="&#xE71E;" />
                                        </Button>

                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind TargetFolderName}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ConfidenceText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind MethodText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Nur im Schritt-für-Schritt-Modus: Zurück und der eine Aktionsknopf -->
        <Grid
            Grid.Row="3"
            Padding="24,4,24,16"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.Wizard.IsGuided, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{x:Bind ViewModel.Wizard.GoBackCommand}"
                x:Uid="SortPage_BackButton" />

            <!-- Während eines Laufs steht das Anhalten hier unten, neben dem
                 Aktionsknopf: Dort sucht man es, wenn ein Lauf über Stunden geht. In der
                 Karte allein wäre es nur zu finden, wer weit genug scrollt. -->
            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.CancelCommand}"
                x:Uid="SortPage_PauseButtonBottom"
                Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button
                Grid.Column="2"
                MinWidth="140"
                Command="{x:Bind ViewModel.Wizard.PrimaryActionCommand}"
                Content="{x:Bind ViewModel.Wizard.PrimaryActionLabel, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
