<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.SortPage"
    x:Name="SortPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PictureSorter.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Immer sichtbar: KI-Hinweis, Titel und Ansichts-Umschalter -->
        <StackPanel Padding="24,16,24,8" Spacing="12">
            <InfoBar
                x:Uid="SortPage_ModelHintBar"
                IsClosable="False"
                IsOpen="{x:Bind ModelHint.IsHintVisible, Mode=OneWay}"
                Message="{x:Bind ModelHint.Message, Mode=OneWay}"
                Severity="Warning"
                Title="KI noch nicht einsatzbereit">
                <InfoBar.ActionButton>
                    <Button x:Uid="SortPage_SetupOllamaButton" Click="OnSetupOllamaClick" Content="Jetzt einrichten" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--
                Rückgängig-Hinweis. Bewusst hier oben und nicht in der Schritt-5-Karte:
                Der Lauf steht dauerhaft im Protokoll, also soll er auch nach einem
                Neustart oder auf Schritt 1 noch zurückzunehmen sein.
            -->
            <InfoBar
                x:Uid="SortPage_UndoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasUndoableRun, Mode=OneWay}"
                Message="{x:Bind ViewModel.UndoSummary, Mode=OneWay}"
                Severity="Success"
                Title="Letzte Sortierung">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="SortPage_UndoButton"
                        Command="{x:Bind ViewModel.UndoCommand}"
                        Content="Rückgängig machen" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource HeroBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Uid="SortPage_HeroTitle" Style="{StaticResource HeroTitleStyle}" Text="Fotos sortieren" />
                        <TextBlock
                            x:Uid="SortPage_HeroSubtitle"
                            Style="{StaticResource HeroSubtitleStyle}"
                            Text="Beschreibe eine Gruppe, bestätige ein paar Beispiele – den Rest übernimmt PictureSorter." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="SortPage_ViewModeLabel"
                        Text="Ansicht:" />
                    <ComboBox
                        x:Name="ViewModeCombo"
                        MinWidth="170"
                        AutomationProperties.Name="Ansicht"
                        SelectionChanged="OnViewModeChanged">
                        <ComboBoxItem x:Uid="SortPage_ViewModeStepByStep" Content="Schritt für Schritt" />
                        <ComboBoxItem x:Uid="SortPage_ViewModeStandard" Content="Standard" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Nur im Schritt-für-Schritt-Modus: klickbare Schrittleiste + Titel + Neustart -->
        <StackPanel
            Grid.Row="1"
            Padding="24,0,24,8"
            Spacing="6"
            Visibility="{x:Bind ViewModel.Wizard.IsGuided, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Schrittleiste: Sprung zu bereits erreichten Schritten. Der ContentControl
                 deaktiviert die ganze Leiste, während ein Vorgang läuft. -->
            <ContentControl
                HorizontalContentAlignment="Left"
                IsEnabled="{x:Bind ViewModel.Wizard.IsInteractive, Mode=OneWay}"
                IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="2">
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step1Link"
                    Content="1. Ordner"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep1, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=0}"
                    Tag="0" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step2Link"
                    Content="2. Kategorie"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep2, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=1}"
                    Tag="1" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step3Link"
                    Content="3. Passende"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep3, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=2}"
                    Tag="2" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step4Link"
                    Content="4. Gegenbeispiele"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep4, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=3}"
                    Tag="3" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step5Link"
                    Content="5. Analyse"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep5, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=4}"
                    Tag="4" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="▸" />
                <HyperlinkButton
                    Padding="4,2"
                    Click="OnStepClick"
                    x:Uid="SortPage_Step6Link"
                    Content="6. Sortieren"
                    FontWeight="{x:Bind ViewModel.Wizard.IsStep6, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                    IsEnabled="{x:Bind ViewModel.Wizard.MaxReachedStep, Mode=OneWay, Converter={StaticResource StepReachedConverter}, ConverterParameter=5}"
                    Tag="5" />
                </StackPanel>
            </ContentControl>

            <!-- Titel des aktuellen Schritts + Neu starten -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Wizard.StepTitle, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.Wizard.RestartCommand}"
                    x:Uid="SortPage_RestartButton"
                    Content="↺ Neu starten" />
            </Grid>
        </StackPanel>

        <!-- Inhalt: Schritt-Karten. Im Schritt-Modus nur die aktive, im Standard alle. -->
        <ScrollViewer Grid.Row="2" Padding="24,4,24,12">
            <StackPanel MaxWidth="840" Spacing="16">

                <!-- Schritt 1: Quellordner -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step1Heading" FontWeight="SemiBold" Text="1. Ordner mit Fotos wählen" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step1Description"
                            Text="Wähle den Ordner, in dem deine Fotos liegen. PictureSorter sieht sie sich an und hilft dir, sie zu ordnen."
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="SortPage_SourceFolderBox"
                                Header="Ordner mit Fotos"
                                PlaceholderText="z. B. C:\Fotos"
                                Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseCommand}"
                                x:Uid="SortPage_BrowseButton"
                                Content="Durchsuchen…" />
                        </Grid>
                        <CheckBox
                            x:Uid="SortPage_IncludeSubfoldersCheck"
                            Content="Auch Unterordner einbeziehen"
                            IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Schritt 2: Kategorie beschreiben -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step2Heading" FontWeight="SemiBold" Text="2. Kategorie beschreiben" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step2Description"
                            Text="Was sollen wir heraussuchen? Gib der Gruppe einen Namen und beschreibe in eigenen Worten, was darauf zu sehen ist."
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Uid="SortPage_CategoryNameBox"
                            Header="Name der Gruppe"
                            PlaceholderText="z. B. Familie"
                            Text="{x:Bind ViewModel.CategoryName, Mode=TwoWay}" />
                        <TextBox
                            x:Uid="SortPage_CategoryDescriptionBox"
                            Header="Beschreibung (in eigenen Worten)"
                            AcceptsReturn="True"
                            PlaceholderText="z. B. Bilder, auf denen meine Familie zu sehen ist"
                            Text="{x:Bind ViewModel.CategoryDescription, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            x:Uid="SortPage_EventCategoryCheck"
                            Content="Ereignis-Gruppe (Ordnername erhält das Aufnahmedatum, z. B. „Urlaub 14.07.25“)"
                            IsChecked="{x:Bind ViewModel.IsEventCategory, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Schritt 3: Bilder, die zur Gruppe gehören -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step3Heading" FontWeight="SemiBold" Text="3. Diese Bilder gehören dazu" />
                        <TextBlock
                            x:Uid="SortPage_Step3Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Suche Bilder heraus, die eindeutig zur Gruppe gehören. Wenige klare Beispiele wirken besser als viele unklare."
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PositiveExamples.CapacityText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="SortPage_SuggestPositivesButton"
                                Command="{x:Bind ViewModel.SuggestPositivesCommand}"
                                Content="Vorschläge holen" />
                            <Button
                                x:Uid="SortPage_PickPositivesButton"
                                Command="{x:Bind ViewModel.PickPositivesCommand}"
                                Content="Selbst auswählen" />
                        </StackPanel>
                        <Border
                            Padding="8"
                            AllowDrop="True"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DragOver="OnPositivesDragOver"
                            Drop="OnPositivesDrop">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="SortPage_DropHint"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Du kannst Bilder auch aus dem Explorer hierher ziehen."
                                    TextWrapping="Wrap" />
                                <GridView
                                    x:Uid="SortPage_PositiveExampleList"
                                    MaxHeight="320"
                                    AutomationProperties.Name="Passende Beispielbilder"
                                    ItemsSource="{x:Bind ViewModel.PositiveExamples.Items}"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExampleCandidateViewModel">
                                            <StackPanel
                                                Width="170"
                                                Padding="6"
                                                Spacing="4">
                                                <Image
                                                    Height="120"
                                                    AutomationProperties.Name="{x:Bind FileName}"
                                                    Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                    Stretch="UniformToFill"
                                                    ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                                <TextBlock
                                                    MaxWidth="158"
                                                    FontSize="12"
                                                    Text="{x:Bind FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    x:Uid="SortPage_RemoveExampleButton"
                                                    Padding="6,2"
                                                    Command="{Binding ViewModel.PositiveExamples.RemoveCommand, ElementName=SortPageRoot}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Entfernen"
                                                    FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Schritt 4: Bilder, die ausdrücklich NICHT dazugehören -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep4, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step4Heading" FontWeight="SemiBold" Text="4. Diese Bilder gehören nicht dazu" />
                        <TextBlock
                            x:Uid="SortPage_Step4Description"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Am hilfreichsten sind Bilder, die dem Motiv nahe kommen, aber nicht gemeint sind. Dieser Schritt ist freiwillig."
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.NegativeExamples.CapacityText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="SortPage_SuggestNegativesButton"
                                Command="{x:Bind ViewModel.SuggestNegativesCommand}"
                                Content="Vorschläge holen" />
                            <Button
                                x:Uid="SortPage_PickNegativesButton"
                                Command="{x:Bind ViewModel.PickNegativesCommand}"
                                Content="Selbst auswählen" />
                            <Button
                                x:Uid="SortPage_LearnButton"
                                Command="{x:Bind ViewModel.LearnCommand}"
                                Content="Profil lernen"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Border
                            Padding="8"
                            AllowDrop="True"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DragOver="OnNegativesDragOver"
                            Drop="OnNegativesDrop">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="SortPage_DropHintNegative"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Auch hier lassen sich Bilder aus dem Explorer hereinziehen."
                                    TextWrapping="Wrap" />
                                <GridView
                                    x:Uid="SortPage_NegativeExampleList"
                                    MaxHeight="320"
                                    AutomationProperties.Name="Gegenbeispiele"
                                    ItemsSource="{x:Bind ViewModel.NegativeExamples.Items}"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExampleCandidateViewModel">
                                            <StackPanel
                                                Width="170"
                                                Padding="6"
                                                Spacing="4">
                                                <Image
                                                    Height="120"
                                                    AutomationProperties.Name="{x:Bind FileName}"
                                                    Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                    Stretch="UniformToFill"
                                                    ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                                <TextBlock
                                                    MaxWidth="158"
                                                    FontSize="12"
                                                    Text="{x:Bind FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    x:Uid="SortPage_RemoveExampleButton"
                                                    Padding="6,2"
                                                    Command="{Binding ViewModel.NegativeExamples.RemoveCommand, ElementName=SortPageRoot}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Entfernen"
                                                    FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>
                        <TextBlock>
                            <Run x:Uid="SortPage_ActiveGroupLabel" Text="Aktive Gruppe:" />
                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveCategoryName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Schritt 5: Analyse starten -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep5, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step5Heading" FontWeight="SemiBold" Text="5. Analyse starten" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step5Description"
                            Text="Jetzt sieht sich PictureSorter alle Fotos im Ordner an und schlägt vor, welche zur Gruppe passen. Das kann je nach Anzahl etwas dauern."
                            TextWrapping="Wrap" />

                        <!-- Zeitraum: schränkt die Analyse ein, bevor der teure Teil
                             beginnt. Fotos außerhalb kommen der KI gar nicht erst vor. -->
                        <TextBlock
                            x:Uid="SortPage_DateRangeHeading"
                            FontWeight="SemiBold"
                            Text="Zeitraum (freiwillig)" />
                        <TextBlock
                            x:Uid="SortPage_DateRangeDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Beschränkt die Analyse auf Fotos aus diesen Tagen — praktisch für einen Urlaub. Bilder außerhalb sieht sich die KI gar nicht erst an, der Lauf wird dadurch deutlich kürzer. Ohne Angabe werden alle Fotos geprüft."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DatePicker
                                x:Uid="SortPage_DateFromPicker"
                                Header="Von"
                                SelectedDate="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                            <DatePicker
                                x:Uid="SortPage_DateToPicker"
                                Header="Bis"
                                SelectedDate="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
                            <Button
                                x:Uid="SortPage_ClearDateRangeButton"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ClearDateRangeCommand}"
                                Content="Aufheben" />
                        </StackPanel>

                        <!-- Urlaube vorschlagen: reine Rechnerei auf den Aufnahmedaten,
                             ohne KI. Wo zwischen zwei Aufnahmen eine längere Pause liegt,
                             endet ein Zeitraum. -->
                        <Button
                            x:Uid="SortPage_SuggestTripsButton"
                            Command="{x:Bind ViewModel.SuggestTripsCommand}"
                            Content="Urlaube vorschlagen" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TripHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.TripHint, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TripSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TripSuggestionViewModel">
                                    <HyperlinkButton
                                        Command="{Binding ElementName=SortPageRoot, Path=ViewModel.UseTripSuggestionCommand}"
                                        CommandParameter="{x:Bind}"
                                        Content="{x:Bind Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            x:Uid="SortPage_AnalyzeButton"
                            Content="Analysieren"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Schritt 6: Vorschau und Sortieren -->
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Wizard.ShowStep6, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SortPage_Step6Heading" FontWeight="SemiBold" Text="6. Sortieren" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_Step6Description"
                            Text="Prüfe die Vorschläge. Bei Bildern, die du nicht möchtest, das Häkchen entfernen – sie werden nicht verschoben und nicht erneut vorgeschlagen. Klicke auf ein Bild, um es groß anzusehen."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SortPage_BackupHint"
                            Text="Vor dem ersten Sortieren: Lege eine Sicherungskopie deiner Fotos an. Ein Lauf lässt sich zwar vollständig zurücknehmen, eine Kopie schützt aber auch vor allem, was PictureSorter nicht in der Hand hat."
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Command="{x:Bind ViewModel.Proposals.ToggleAllCommand}"
                                x:Uid="SortPage_ToggleAllButton"
                                Content="Alle aus-/abwählen" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Proposals.SelectionSummary, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ApplyCommand}"
                                x:Uid="SortPage_ApplyButton"
                                Content="Sortieren"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <!-- Steht bewusst direkt über dem Sortieren-Knopf: Der Weg, auf dem
                             die Fotos ihren Ordner erreichen, gehört dorthin, wo man ihn
                             auslöst, nicht in eine Einstellungsseite. -->
                        <CheckBox
                            x:Uid="SortPage_CopyInsteadOfMoveCheck"
                            Content="Fotos kopieren statt verschieben (Originale bleiben liegen)"
                            IsChecked="{x:Bind ViewModel.CopyInsteadOfMove, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.Wizard.ShowStandardActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ListView
                            x:Uid="SortPage_ProposalList"
                            MaxHeight="360"
                            AutomationProperties.Name="Vorschläge"
                            ItemsSource="{x:Bind ViewModel.Proposals.Items}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProposalViewModel">
                                    <Grid
                                        Padding="0,6"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Diesen Vorschlag übernehmen"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            x:Uid="SortPage_ProposalSelectCheck"
                                            ToolTipService.ToolTip="Häkchen entfernen heißt: nicht verschieben und künftig nicht mehr vorschlagen." />
                                        <!-- Klick auf das Bild öffnet die Großansicht. -->
                                        <Button
                                            Grid.Column="1"
                                            Padding="0"
                                            AutomationProperties.Name="Bild groß ansehen"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnProposalImageClick"
                                            Tag="{x:Bind}">
                                            <Image
                                                Width="56"
                                                Height="56"
                                                AutomationProperties.Name="{x:Bind FileName}"
                                                Source="{x:Bind FilePath, Converter={StaticResource ThumbnailConverter}}"
                                                Stretch="UniformToFill"
                                                ToolTipService.ToolTip="{x:Bind InfoTooltip}" />
                                        </Button>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind TargetFolderName}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ConfidenceText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind MethodText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Nur im Schritt-für-Schritt-Modus: Zurück und der eine Aktionsknopf -->
        <Grid
            Grid.Row="3"
            Padding="24,4,24,16"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.Wizard.IsGuided, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{x:Bind ViewModel.Wizard.GoBackCommand}"
                x:Uid="SortPage_BackButton"
                Content="◀ Zurück" />
            <Button
                Grid.Column="2"
                MinWidth="140"
                Command="{x:Bind ViewModel.Wizard.PrimaryActionCommand}"
                Content="{x:Bind ViewModel.Wizard.PrimaryActionLabel, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
