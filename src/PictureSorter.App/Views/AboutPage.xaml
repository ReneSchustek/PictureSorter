<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="680" Spacing="16">
            <TextBlock
                x:Uid="AboutPage_SettingsTitle"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Einstellungen" />

            <!-- Darstellung -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AboutPage_AppearanceHeader" FontWeight="SemiBold" Text="Darstellung" />
                    <TextBlock
                        x:Uid="AboutPage_AppearanceDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Wähle zwischen hellem und dunklem Design."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="DarkToggle"
                        x:Uid="AboutPage_DarkToggle"
                        Header="Dunkles Design"
                        OffContent="Aus"
                        OnContent="An"
                        Toggled="OnDarkToggled" />
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="AboutPage_UpdatesHeader" FontWeight="SemiBold" Text="Updates" />
                    <TextBlock
                        x:Uid="AboutPage_UpdatesDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="PictureSorter kann beim Start nach einer neueren Version suchen und sie auf Wunsch automatisch installieren."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="UpdateCheckToggle"
                        x:Uid="AboutPage_UpdateCheckToggle"
                        Header="Beim Start nach Updates suchen"
                        OffContent="Aus"
                        OnContent="An"
                        Toggled="OnUpdateCheckToggled" />
                    <ToggleSwitch
                        x:Name="AutoUpdateToggle"
                        x:Uid="AboutPage_AutoUpdateToggle"
                        Header="Updates automatisch installieren"
                        OffContent="Aus"
                        OnContent="An"
                        Toggled="OnAutoUpdateToggled" />
                    <InfoBar
                        x:Name="UpdateStatusBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Noch nicht geprüft."
                        Severity="Informational" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="AboutPage_CheckUpdatesButton"
                            Click="OnCheckUpdatesClick"
                            Content="Nach Updates suchen" />
                        <Button
                            x:Name="InstallUpdateButton"
                            x:Uid="AboutPage_InstallUpdateButton"
                            Click="OnInstallUpdateClick"
                            Content="Jetzt aktualisieren"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Lokale KI (Ollama) -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="AboutPage_LocalAiHeader" FontWeight="SemiBold" Text="Lokale KI (Ollama)" />
                    <TextBlock
                        x:Uid="AboutPage_LocalAiDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap">
                        PictureSorter erkennt Bildinhalte mit einer KI, die vollständig auf
                        diesem PC läuft – deine Fotos verlassen den Rechner nicht. Falls das
                        Sortieren nicht startet, richte die KI hier mit einem Klick ein. Der
                        Download kann beim ersten Mal einige Minuten dauern.
                    </TextBlock>
                    <InfoBar
                        x:Name="KiStatusBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Status wird geprüft…"
                        Severity="Informational" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="AboutPage_SetupButton"
                            Click="OnSetupClick"
                            Content="Jetzt einrichten"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button
                            x:Uid="AboutPage_CheckStatusButton"
                            Click="OnCheckClick"
                            Content="Status prüfen" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Protokoll (Fehlerdiagnose) -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="AboutPage_LogHeader" FontWeight="SemiBold" Text="Protokoll (Fehlerdiagnose)" />
                    <TextBlock
                        x:Uid="AboutPage_LogDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap">
                        Hier siehst du die jüngsten Programmmeldungen. Wenn etwas nicht
                        funktioniert, hilft dieser Verlauf bei der Ursachensuche. Die
                        vollständigen, täglichen Protokolldateien liegen im Log-Ordner.
                    </TextBlock>
                    <TextBox
                        x:Name="LogSearchBox"
                        x:Uid="AboutPage_LogSearch"
                        Header="Suche"
                        PlaceholderText="Im Protokoll suchen"
                        TextChanged="OnLogSearchChanged" />
                    <ToggleSwitch
                        x:Name="ProblemsOnlyToggle"
                        x:Uid="AboutPage_ProblemsOnlyToggle"
                        Header="Nur Warnungen und Fehler"
                        OffContent="Aus"
                        OnContent="An"
                        Toggled="OnProblemsOnlyToggled" />
                    <TextBox
                        x:Name="LogView"
                        Height="220"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="LogSummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="AboutPage_RefreshLogButton"
                            Click="OnRefreshLogClick"
                            Content="Aktualisieren" />
                        <Button
                            x:Uid="AboutPage_OpenLogFolderButton"
                            Click="OnOpenLogFolderClick"
                            Content="Log-Ordner öffnen" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AboutPage_AboutHeader" FontWeight="SemiBold" Text="Über PictureSorter" />
                    <TextBlock x:Uid="AboutPage_AboutDescription" TextWrapping="Wrap">
                        PictureSorter sortiert Fotos mithilfe einer lokal laufenden KI (Ollama)
                        lernfähig in Unterordner. Alle Bildanalysen geschehen offline auf diesem Rechner.
                    </TextBlock>
                    <TextBlock
                        x:Name="VersionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
