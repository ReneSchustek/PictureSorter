<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PictureSorter.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PictureSorter.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel
            MaxWidth="900"
            Margin="24"
            Spacing="20">

            <!-- Hero-Kopf -->
            <Border Style="{StaticResource HeroBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="DashboardPage_HeroTitle"
                        Style="{StaticResource HeroTitleStyle}"
                        Text="Willkommen bei PictureSorter" />
                    <TextBlock
                        x:Uid="DashboardPage_HeroSubtitle"
                        Style="{StaticResource HeroSubtitleStyle}"
                        Text="Ordne deine Fotos in wenigen Schritten. Alles läuft auf deinem Rechner – nichts wird ins Internet geladen." />
                </StackPanel>
            </Border>

            <!-- Zustand der lokalen KI -->
            <InfoBar
                x:Uid="DashboardPage_AiStatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.AiStatusText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.IsAiReady, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                Title="Lokale KI" />

            <TextBlock
                x:Uid="DashboardPage_ActionsPrompt"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Was möchtest du tun?" />

            <!-- Kacheln in die drei Bereiche.
                 Bewusst kein GridView: Dort steckte jede Schaltfläche zusätzlich in
                 einem Listenelement. Ein Screenreader las damit zwei Rollen für ein
                 Bedienelement vor, und die Kacheln waren nur über die Pfeiltasten
                 erreichbar statt über Tab wie jede andere Schaltfläche. -->
            <VariableSizedWrapGrid
                x:Uid="DashboardPage_Tiles"
                AutomationProperties.Name="Bereiche"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,12,12"
                    AutomationProperties.Name="Fotos sortieren"
                    Command="{x:Bind ViewModel.OpenSortCommand}"
                    Style="{StaticResource TileButtonStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="26"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            x:Uid="DashboardPage_SortTileTitle"
                            FontWeight="SemiBold"
                            Text="Fotos sortieren" />
                        <TextBlock
                            x:Uid="DashboardPage_SortTileDescription"
                            MaxWidth="220"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Beschreibe eine Gruppe, bestätige ein paar Beispiele – der Rest passiert automatisch."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Margin="0,0,12,12"
                    AutomationProperties.Name="Duplikate finden"
                    Command="{x:Bind ViewModel.OpenDuplicatesCommand}"
                    Style="{StaticResource TileButtonStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="26"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8C8;" />
                        <TextBlock
                            x:Uid="DashboardPage_DuplicatesTileTitle"
                            FontWeight="SemiBold"
                            Text="Duplikate finden" />
                        <TextBlock
                            x:Uid="DashboardPage_DuplicatesTileDescription"
                            MaxWidth="220"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Doppelte und sehr ähnliche Bilder aufspüren und in den Papierkorb legen."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Margin="0,0,12,12"
                    AutomationProperties.Name="Gedächtnis verwalten"
                    Command="{x:Bind ViewModel.OpenMemoryCommand}"
                    Style="{StaticResource TileButtonStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="26"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE81C;" />
                        <TextBlock
                            x:Uid="DashboardPage_MemoryTileTitle"
                            FontWeight="SemiBold"
                            Text="Gedächtnis" />
                        <TextBlock
                            x:Uid="DashboardPage_MemoryTileDescription"
                            MaxWidth="220"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sieh nach, was sich PictureSorter gemerkt hat – und vergiss, was nicht stimmt."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </VariableSizedWrapGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
