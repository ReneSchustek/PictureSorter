{
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "EmbeddingModel": "nomic-embed-text",
    "VisionModel": "llava",
    "RequestTimeoutSeconds": 120,
    "AvailabilityTimeoutSeconds": 5,
    "MaxResponseTokens": 96,
    "KeepAlive": "30m"
  },
  "PhotoSource": {
    "MaxParallelReads": 8
  },
  "Sorting": {
    "UpperSimilarityThreshold": 0.78,
    "LowerSimilarityThreshold": 0.45,
    "VisionConfidenceThreshold": 0.5,
    "BulkConfirmationThreshold": 50,
    "MaxExamplesPerSide": 15,
    "MaxParallelEvaluations": 4
  },
  "TripDetection": {
    "MaxGapDays": 2,
    "MinPhotos": 8
  },
  "Duplicates": {
    "DetectSimilar": true,
    "MaxHammingDistance": 8,
    "MaxParallelFingerprints": 4
  },
  "Update": {
    "GitHubOwner": "ReneSchustek",
    "GitHubRepo": "PictureSorter"
  }
}
