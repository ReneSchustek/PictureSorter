<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-SDK-Ziel wegen Windows.Storage (Löschen in den Papierkorb).
         Enthält Dateisystem-, Update- (GitHub), Cache- und JSON-Persistenz-Dienste –
         alles außer Datenbank. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PictureSorter.Core\PictureSorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- IHttpClientFactory + getypter Client für die GitHub-Update-Prüfung. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Options-Pattern für die Update-Konfiguration aus appsettings.json. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSorter.Infrastructure.Tests" />
  </ItemGroup>

</Project>
