<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Reine Orchestrierungsschicht ohne Windows-/WinRT-Abhängigkeit; daher das
         plattformneutrale TFM (wie Core/Data/Ollama). So bleibt die Use-Case-Logik
         ohne Windows-Targeting-Pack baubar und testbar. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PictureSorter.Core\PictureSorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- DI-Registrierung der Use-Case-Dienste. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSorter.Application.Tests" />
  </ItemGroup>

</Project>
