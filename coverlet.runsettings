<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Gemessen wird der Code, der eine Entscheidung trifft. Ausgenommen ist,
               was ohne laufende Oberfläche nicht ausführbar ist oder keine Logik trägt:
               die WinUI-Views samt generiertem XAML-Code, die reinen
               Verdrahtungs-Erweiterungen des DI-Containers und die quellgenerierten
               Logmeldungen. Eine Zahl, die solchen Code mitzählt, misst nicht die
               Testtiefe, sondern nur, wie viel Rahmenwerk das Projekt hat.

               Achtung: Die App-Assembly heißt „PictureSorter", nicht
               „PictureSorter.App" (AssemblyName in der csproj). Ein Filter auf den
               Projektnamen greift ins Leere und wirkt trotzdem, als wäre gefiltert. -->
          <Exclude>[PictureSorter]PictureSorter.App.Views.*,[PictureSorter]PictureSorter.App.Controls.*,[PictureSorter]PictureSorter.App.App,[PictureSorter]XamlGeneratedNamespace.*,[PictureSorter]PictureSorter.App.PictureSorter_App_XamlTypeInfo.*,[PictureSorter]ABI.*,[PictureSorter]WinRT.*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <!-- Zusätzlich ausgenommen: Code, der ohne laufende Oberfläche bzw. ohne
               fremden Prozess nicht ausführbar ist (WinUI-Konverter, Fensterkontext,
               Ordnerauswahl, Dialoge, Design-Umschaltung, Navigationsleiste,
               Ollama-Einrichtung, Aufrufe der Windows-Shell). Ihn mitzuzählen sagt
               nichts über die Testtiefe – er wird in der laufenden Anwendung geprüft,
               nicht im Testhost. Gemeinsames Merkmal: Diese Klassen treffen keine
               Entscheidung, sie reichen einen Aufruf weiter. Alles, was entschieden
               wird, steht anderswo und ist geprüft. -->
          <ExcludeByFile>**/*ServiceCollectionExtensions.cs,**/Migrations/*.cs,**/*.g.cs,**/Converters/*.cs,**/Services/ThemeService.cs,**/Services/NavigationService.cs,**/Services/WindowContext.cs,**/Services/WindowsFolderPicker.cs,**/Services/ContentDialogConfirmationService.cs,**/Services/OllamaSetupService.cs,**/Services/ResourceLocalizer.cs,**/Services/ShellLauncher.cs,**/Services/ShellIconRefresher.cs</ExcludeByFile>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
